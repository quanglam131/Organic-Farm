{
    "info": {
        "name": "Farm E-commerce API (Tuần 5)",
        "_postman_id": "6f1c2a10-5b7e-4c33-9a8d-0a0a05f00d05",
        "description": "Kịch bản kiểm thử API và thuật toán FEFO.\n\nChạy theo thứ tự thư mục từ trên xuống. Trước khi chạy: `php artisan migrate --seed` (hoặc `php artisan db:seed --class=FefoTestSeeder`).\n\nTài khoản: admin@farm.local / password, khach@farm.local / password.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:8000/api"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "customerToken",
            "value": ""
        },
        {
            "key": "productId",
            "value": ""
        },
        {
            "key": "batchId",
            "value": ""
        },
        {
            "key": "traceCode",
            "value": ""
        }
    ],
    "auth": {
