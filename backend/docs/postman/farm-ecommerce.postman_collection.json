                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{customerToken}}",
                                    "type": "string"
                                }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Mã 403', () => pm.response.to.have.status(403));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Dữ liệu sai khi tạo lô → 422 kèm danh sách lỗi",
                    "request": {
