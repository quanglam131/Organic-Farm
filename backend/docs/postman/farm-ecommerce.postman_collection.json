                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Mã 401', () => pm.response.to.have.status(401));",
                                    "pm.test('Có status=error', () => pm.expect(pm.response.json().status).to.eql('error'));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Khách hàng gọi API quản trị → 403",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/admin/orders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
