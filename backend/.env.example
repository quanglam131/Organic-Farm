APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----- Farm shop settings -----
FRONTEND_URL=http://localhost:5173
# true = simulated payment page (no merchant account needed). Set false in production.
PAYMENT_MOCK_ENABLED=true
# VNPay sandbox credentials (leave empty to use the mock gateway)
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Cloudinary (leave empty to store images on the local public disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Shipping: free above this subtotal; base fee covers 3 km, then per-km fee
SHOP_FREE_SHIPPING_THRESHOLD=300000
SHOP_SHIPPING_BASE_FEE=15000
SHOP_SHIPPING_PER_KM_FEE=5000
# Google Maps Distance Matrix key (optional). Empty = OpenStreetMap geocoding + straight-line distance x 1.3
GOOGLE_MAPS_API_KEY=
SHIPPING_ROAD_FACTOR=1.3
# Login tokens expire after this many minutes; the app then shows a "log in again" popup
SANCTUM_EXPIRATION=480

# ----- The farm (Single Farm model): shown on the site, used as the shipping origin -----
FARM_NAME="Nông trại Xanh Đà Lạt"
FARM_SLOGAN="Rau sạch từ vườn đến bàn ăn trong 24 giờ"
FARM_ADDRESS="Thôn Đa Thọ, xã Xuân Thọ, TP. Đà Lạt, Lâm Đồng"
FARM_PHONE="0263 3123 456"
FARM_EMAIL=lienhe@nongtraixanh.example
FARM_LATITUDE=11.9465
FARM_LONGITUDE=108.5003
