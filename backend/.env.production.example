# Production settings (Tuần 7). Copy to the host's environment variables; never commit real values.
APP_NAME="Nong trai Xanh"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-app.onrender.com
FRONTEND_URL=https://your-app.onrender.com
LOG_CHANNEL=stderr

# Online MySQL (Aiven / Railway / PlanetScale / VPS), not the local XAMPP database
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SANCTUM_EXPIRATION=480

PAYMENT_MOCK_ENABLED=false
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://your-app.onrender.com/api/payments/vnpay/return

# Images must go to Cloudinary in production: the container's disk is wiped on every deploy
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_MAPS_API_KEY=
MAIL_MAILER=log
